PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.j3s8c0x.mongodb.net/ai_ecommerce?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=your_jwt_secret_token_here

# Groq LLaMA or Gemini AI API Key (Optional: system automatically uses built-in grounded NLP engine if blank)
GROQ_API_KEY=
AI_API_KEY=

# Frontend Application URL
FRONTEND_URL=http://localhost:3000

# WhatsApp Notification Providers
# Option 1 (Default): WhatsApp Web QR Session (Baileys) — Free direct WhatsApp
#   Open /api/whatsapp/scan on your deployed Render app and scan with your phone.
#   Session is permanently saved to your MongoDB Atlas database so it persists across restarts!
DEFAULT_CUSTOMER_PHONE=+919790380815
MERCHANT_PHONE=+919790380815
CLIENT_PHONE=+919790380815

# Option 2: Twilio WhatsApp API (Cloud Reliable, No QR needed)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Option 3: CallMeBot WhatsApp API (100% Free Cloud Alternative)
# Get free API key by sending message on WhatsApp (see https://www.callmebot.com/blog/free-api-whatsapp-messages/)
CALLMEBOT_API_KEY=

# Option 4: Meta WhatsApp Business Cloud API
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Brevo (Sendinblue) Transactional Email & PDF Invoice Dispatch
BREVO_API_KEY=your_brevo_v3_api_key_here
BREVO_SENDER_EMAIL=notifications@yourdomain.com
BREVO_SENDER_NAME=Nexora AI Store
